# Copy to .env for local development. Wrangler reads it as binding vars.
# In production use: pnpm dlx wrangler pages secret put NAME

# Signs the session cookie. Minimum 32 characters.
# openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth App: https://github.com/settings/developers
# Callback URL: http://localhost:4321/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client, type Web: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:4321/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
