# Salin ke .env (sudah di-gitignore) untuk pengembangan lokal.
# Wrangler membacanya sebagai variabel binding — dicek pada wrangler 4.125,
# log dev server menyebut "Using vars defined in .env".
# Di produksi jangan pakai file ini: pnpm dlx wrangler pages secret put NAMA

# Kunci tanda tangan cookie sesi. Minimal 32 karakter — server menolak jalan
# kalau lebih pendek, karena cookie yang bisa ditebak sama saja tanpa login.
# Buat dengan: openssl rand -hex 32
AUTH_SECRET=

# GitHub OAuth App: https://github.com/settings/developers
# Authorization callback URL: http://localhost:4321/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth Client (tipe Web): https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4321/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
