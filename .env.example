# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=development

# Cloudflare D1 Database (for local development)
# Get this ID when you create your D1 database with: wrangler d1 create mambruk-db
DATABASE_ID=your-database-id-here

# Optional: Custom domain for shortened URLs (production only)
# BASE_URL=https://your-domain.com

# Optional: Analytics and monitoring
# ANALYTICS_TOKEN=your-analytics-token

# Development only - Cloudflare API credentials (if needed for local D1)
# CLOUDFLARE_API_TOKEN=your-api-token
# CLOUDFLARE_ACCOUNT_ID=your-account-id