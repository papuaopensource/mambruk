# Mambruk environment file

# Secret used to encrypt the session cookie. You can generate a new one with `openssl rand -hex 32`
AUTH_SECRET=

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client. # Google OAuth Client https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
