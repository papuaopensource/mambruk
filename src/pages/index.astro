---
import Layout from '../layouts/Layout.astro'
import { getUser } from '../utils/auth'

export const prerender = false

const user = await getUser(Astro)
---

<Layout>
  <main class="container mx-auto px-4 py-12 max-w-2xl">
    <nav class="flex justify-end mb-8">
      <a
        class="text-sm font-medium text-neutral-600 hover:text-neutral-900 underline underline-offset-4"
        href="/app"
      >
        {user ? 'Dashboard' : 'Sign in'}
      </a>
    </nav>

    <div class="text-center">
      <h1 class="text-5xl font-extrabold tracking-tight">Mambruk</h1>
      <p class="mt-3 text-lg text-neutral-600">
        Shorten your links and gather them on one page.
      </p>
    </div>

    <!-- Link shortener -->
    <section
      class="mt-10 bg-white border border-neutral-800 rounded-xl p-6 sm:p-8"
    >
      <p
        class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-4"
      >
        Link shortener
      </p>

      <form id="shortenForm" class="flex flex-col sm:flex-row gap-3">
        <input
          type="url"
          id="urlInput"
          name="url"
          placeholder="https://example.com/a/very/long/link"
          required
          class="flex-1 px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden transition-colors"
        />
        <button
          type="submit"
          id="shortenBtn"
          class="px-6 py-3 rounded-lg bg-neutral-800 text-white font-semibold hover:bg-neutral-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Shorten
        </button>
      </form>

      <div
        id="result"
        class="hidden mt-6 p-4 bg-neutral-50 border border-neutral-200 rounded-lg"
      >
        <label
          for="shortUrl"
          class="block text-sm font-semibold text-neutral-700 mb-2"
        >
          Your short link:
        </label>
        <div class="flex flex-col sm:flex-row gap-2">
          <input
            type="text"
            id="shortUrl"
            readonly
            class="flex-1 px-3 py-2 bg-white border border-neutral-300 rounded-sm font-mono text-sm"
          />
          <button
            id="copyBtn"
            type="button"
            class="px-4 py-2 rounded-sm bg-neutral-800 text-white font-medium hover:bg-neutral-700 transition-colors"
          >
            Copy
          </button>
        </div>
      </div>

      <div
        id="error"
        class="hidden mt-6 p-4 bg-red-50 border border-red-200 rounded-lg"
      >
        <p class="text-red-800 font-medium"></p>
      </div>
    </section>

    <!-- Bio page -->
    <section
      class="mt-6 bg-white border border-neutral-800 rounded-xl p-6 sm:p-8"
    >
      <p
        class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-4"
      >
        Bio page
      </p>
      <p class="text-neutral-600">
        One page for every channel or social media you have, at
        <span class="font-mono text-neutral-800">mambr.uk/@handle</span>.
      </p>
      <a
        class="group relative inline-block mt-5 text-sm font-medium text-neutral-600 focus:outline-hidden active:text-neutral-800"
        href="/@papuaopensource"
      >
        <span
          class="absolute inset-0 translate-x-1.5 translate-y-1.5 bg-neutral-800 rounded-sm"
        ></span>
        <span
          class="relative flex items-center justify-center gap-3 rounded-sm border border-neutral-800 bg-white px-5 py-3 group-hover:translate-x-1 group-hover:translate-y-1 group-focus:translate-x-1 group-focus:translate-y-1"
        >
          See an example: @papuaopensource
        </span>
      </a>
      <p class="mt-4 text-sm text-neutral-500">
        {user ? (
          <a
            class="underline underline-offset-4 hover:text-neutral-800"
            href="/app"
          >
            Manage your page in the dashboard
          </a>
        ) : (
          <>
            <a
              class="underline underline-offset-4 hover:text-neutral-800"
              href="/app"
            >
              Sign in
            </a
            >{' '} with GitHub or Google to build your own page.
          </>
        )}
      </p>
    </section>

    <footer class="mt-12 text-center text-sm text-neutral-500">
      <p>Kontribusi Berbasis Open Source untuk Tanah Papua</p>
      <p class="mt-1">
        &copy; 2026
        <a
          class="hover:text-neutral-800"
          href="https://github.com/papuaopensource"
          >Papua Open Source</a
        >
      </p>
    </footer>
  </main>
</Layout>

<script>
  const form = document.getElementById('shortenForm') as HTMLFormElement
  const urlInput = document.getElementById('urlInput') as HTMLInputElement
  const shortenBtn = document.getElementById('shortenBtn') as HTMLButtonElement
  const result = document.getElementById('result') as HTMLDivElement
  const shortUrlInput = document.getElementById('shortUrl') as HTMLInputElement
  const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement
  const error = document.getElementById('error') as HTMLDivElement

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const url = urlInput.value.trim()
    if (!url) return

    shortenBtn.disabled = true
    shortenBtn.textContent = 'Shortening...'
    error.classList.add('hidden')
    result.classList.add('hidden')

    try {
      const response = await fetch('/api/shorten', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url }),
      })
      const data: { code?: string; error?: string } = await response.json()
      if (!response.ok)
        throw new Error(data.error || 'Could not shorten that URL')

      shortUrlInput.value = `${window.location.origin}/${data.code}`
      result.classList.remove('hidden')
    } catch (err) {
      const message =
        err instanceof Error ? err.message : 'Something went wrong'
      error.querySelector('p')!.textContent = message
      error.classList.remove('hidden')
    } finally {
      shortenBtn.disabled = false
      shortenBtn.textContent = 'Shorten'
    }
  })

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(shortUrlInput.value)
    } catch {
      shortUrlInput.select()
      document.execCommand('copy')
    }
    copyBtn.textContent = 'Copied'
    setTimeout(() => (copyBtn.textContent = 'Copy'), 2000)
  })
</script>
