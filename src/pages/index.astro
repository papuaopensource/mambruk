---
import Layout from '../layouts/Layout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import Icon from '../components/Icon.astro'
import UiIcon from '../components/UiIcon.astro'
import { getUser } from '../utils/auth'
import { HOST as host, SITE } from '../utils/site'

export const prerender = false

const user = await getUser(Astro)

const FEATURES = [
  {
    icon: 'link',
    title: 'Tanpa daftar',
    text: 'Tempel link, langsung dapat versi pendeknya.',
  },
  {
    icon: 'at',
    title: 'Gampang diingat',
    text: `Pakai namamu sendiri, misalnya ${host}/@kamu/ig.`,
  },
  {
    icon: 'chart',
    title: 'Jumlah klik',
    text: 'Lihat berapa kali link-mu dibuka.',
  },
] as const

const PREVIEW_LINKS = [
  { icon: 'globe', label: 'Website' },
  { icon: 'instagram', label: 'Instagram' },
  { icon: 'github', label: 'GitHub' },
]
---

<Layout>
  <SiteHeader user={user} />

  <main class="flex-1">
    <section class="relative isolate overflow-hidden">
      <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div
        class="absolute top-0 left-1/2 -z-10 h-72 w-[42rem] max-w-full -translate-x-1/2 -translate-y-1/3 rounded-full bg-goura-200/60 blur-3xl"
        aria-hidden="true"
      ></div>

      <div class="mx-auto max-w-3xl px-4 pt-20 pb-20 text-center sm:pt-28">
        <h1
          class="text-5xl font-semibold tracking-tight text-balance sm:text-6xl"
        >
          Pendekkan link.
          <span class="block text-neutral-400">Kumpulkan di satu halaman.</span>
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-neutral-600">
          Tempel link panjang, dapat link pendek.
        </p>

        <form
          id="shortenForm"
          class="mx-auto mt-10 max-w-xl"
          data-base={SITE.origin}
        >
          <div
            class="flex items-center gap-2 rounded-full border border-neutral-200 bg-white p-1.5 pl-4 shadow-sm transition focus-within:border-goura-400 focus-within:ring-4 focus-within:ring-goura-100"
          >
            <UiIcon name="link" class="size-4 shrink-0 text-neutral-400" />
            <label for="urlInput" class="sr-only">Link panjang</label>
            <input
              type="url"
              id="urlInput"
              name="url"
              placeholder="Tempel link panjang di sini"
              required
              class="h-9 min-w-0 flex-1 bg-transparent text-sm outline-hidden placeholder:text-neutral-400"
            />
            <button type="submit" id="shortenBtn" class="btn btn-primary">
              Pendekkan
            </button>
          </div>
          {user && <div
            class="mt-3 flex items-center justify-center gap-1 text-sm"
          >
            <span class="shrink-0 text-neutral-500"> {host}/ </span>
            <label for="codeInput" class="sr-only">Link custom</label>
            <input
              id="codeInput"
              name="code"
              placeholder="link-custom"
              pattern="[A-Za-z0-9_\-]{4,32}"
              maxlength="32"
              title="4 sampai 32 karakter: huruf, angka, tanda hubung, atau garis bawah"
              class="w-40 border-b border-dashed border-neutral-300 bg-transparent py-0.5 outline-hidden placeholder:text-neutral-400 focus:border-goura-500"
            />
          </div>}
        </form>

        <div id="result" class="mx-auto mt-4 hidden max-w-xl">
          <div class="flex items-center justify-center gap-2">
            <label for="shortUrl" class="sr-only">Link pendekmu</label>
            <input
              type="text"
              id="shortUrl"
              readonly
              class="field-sizing-content min-w-0 bg-transparent text-lg font-medium text-neutral-900 outline-hidden"
            />
            <button id="copyBtn" type="button" class="btn btn-secondary">
              <UiIcon name="copy" class="size-3.5" />
              <span id="copyLabel">Salin</span>
            </button>
          </div>
        </div>

        <div
          id="error"
          class="mx-auto mt-4 hidden max-w-xl rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-left text-sm text-red-700"
        >
          <p></p>
        </div>

        <p class="mt-4 text-xs text-neutral-500">
          {user ? (
            'Kosongkan link custom kalau ingin link acak.'
          ) : (
            <>
              <a
                class="underline underline-offset-2 hover:text-neutral-900"
                href="/login"
                >Masuk</a
              >
              untuk memilih link sendiri.
            </>
          )}
          Dengan memendekkan link, kamu setuju dengan
          <a
            class="underline underline-offset-2 hover:text-neutral-900"
            href="/terms"
            >Syarat dan Ketentuan</a
          >.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="card grid overflow-hidden lg:grid-cols-2">
        <div class="p-8 sm:p-10">
          <p class="text-sm font-medium text-goura-600">Halaman bio</p>
          <h2 class="mt-2 text-3xl font-semibold tracking-tight">
            Satu alamat untuk semua link-mu
          </h2>
          <p class="mt-3 text-pretty text-neutral-600">
            Kumpulkan semua link-mu di
            <span class="font-mono text-sm text-neutral-900"
              >{host}/@handle</span
            >.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="btn btn-primary" href={user ? '/dashboard' : '/login'}>
              {user ? 'Buka dashboard' : 'Buat halaman bio'}
            </a>
            <a class="btn btn-secondary" href="/@papuaopensource">
              Lihat contoh
            </a>
          </div>
        </div>

        <div
          class="relative flex items-end justify-center overflow-hidden border-t border-neutral-200 bg-neutral-50 px-8 pt-10 lg:border-t-0 lg:border-l"
          aria-hidden="true"
        >
          <div class="bg-grid absolute inset-0"></div>
          <div
            class="relative w-64 rounded-t-[2rem] border border-b-0 border-neutral-200 bg-white px-5 pt-8 pb-6 shadow-xl"
          >
            <img
              src="/assets/pos-logo.png"
              alt=""
              class="mx-auto size-14 rounded-full shadow-sm"
            />
            <p class="mt-3 text-center text-sm font-semibold">
              Papua Open Source
            </p>
            <div class="mt-5 flex flex-col gap-2">
              {PREVIEW_LINKS.map((link) => <span
                class="flex items-center gap-2.5 rounded-xl border border-neutral-900 px-3 py-2.5 text-xs font-medium"
              >
                <Icon name={link.icon} class="size-4" />
                {link.label}
              </span>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-5xl px-4 py-20 sm:px-6">
      <h2 class="text-center text-2xl font-semibold tracking-tight">
        Yang bisa kamu lakukan
      </h2>
      <div class="mt-10 grid gap-4 sm:grid-cols-3">
        {FEATURES.map((feature) => <div class="card p-5">
          <span
            class="flex size-9 items-center justify-center rounded-lg border border-neutral-200 bg-neutral-50 text-goura-600"
          >
            <UiIcon name={feature.icon} class="size-[18px]" />
          </span>
          <h3 class="mt-4 text-sm font-semibold">{feature.title}</h3>
          <p class="mt-1.5 text-sm text-pretty text-neutral-600">
            {feature.text}
          </p>
        </div>)}
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>

<script>
  const form = document.getElementById('shortenForm') as HTMLFormElement
  const urlInput = document.getElementById('urlInput') as HTMLInputElement
  const codeInput = document.getElementById(
    'codeInput'
  ) as HTMLInputElement | null
  const shortenBtn = document.getElementById('shortenBtn') as HTMLButtonElement
  const result = document.getElementById('result') as HTMLDivElement
  const shortUrlInput = document.getElementById('shortUrl') as HTMLInputElement
  const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement
  const copyLabel = document.getElementById('copyLabel') as HTMLSpanElement
  const error = document.getElementById('error') as HTMLDivElement

  // The API answers in English, so the page words its own errors by status.
  const ERRORS: Record<number, string> = {
    400: 'Link ini tidak bisa dipendekkan. Periksa lagi alamatnya, dan pastikan bukan link dari layanan pemendek lain.',
    401: 'Masuk dulu untuk memilih link sendiri.',
    409: 'Link itu sudah dipakai. Coba yang lain.',
    429: 'Terlalu banyak permintaan. Coba lagi dalam satu menit.',
  }
  const FALLBACK = 'Ada masalah di server. Coba lagi sebentar lagi.'

  const showError = (message: string) => {
    error.querySelector('p')!.textContent = message
    error.classList.remove('hidden')
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const url = urlInput.value.trim()
    if (!url) return

    shortenBtn.disabled = true
    shortenBtn.textContent = 'Memproses...'
    error.classList.add('hidden')
    result.classList.add('hidden')

    try {
      const response = await fetch('/api/shorten', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          url,
          code: codeInput?.value.trim() || undefined,
        }),
      })
      if (!response.ok) {
        showError(ERRORS[response.status] ?? FALLBACK)
        return
      }
      const data: { code: string } = await response.json()
      shortUrlInput.value = `${form.dataset.base}/${data.code}`
      result.classList.remove('hidden')
      if (codeInput) codeInput.value = ''
    } catch {
      showError(FALLBACK)
    } finally {
      shortenBtn.disabled = false
      shortenBtn.textContent = 'Pendekkan'
    }
  })

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(shortUrlInput.value)
    } catch {
      shortUrlInput.select()
      document.execCommand('copy')
    }
    copyLabel.textContent = 'Tersalin'
    setTimeout(() => (copyLabel.textContent = 'Salin'), 2000)
  })
</script>
