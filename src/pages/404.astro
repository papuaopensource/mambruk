---
import Layout from '../layouts/Layout.astro'
import { isHandle } from '../utils/code.js'

export const prerender = false

// Routes rewrite here with status 200, so the page sets 404 itself.
Astro.response.status = 404
const handle = Astro.originPathname.match(/^\/@([^/]+)\/?$/)?.[1]?.toLowerCase()
const claimable = isHandle(handle)
---

<Layout title="Page not found">
  <main class="container mx-auto px-4 py-12 max-w-2xl">
    <section
      class="mt-10 bg-white border border-neutral-800 rounded-xl p-6 sm:p-8 text-center"
    >
      <p
        class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-4"
      >
        404
      </p>
      <h1 class="text-3xl font-extrabold tracking-tight">Page not found</h1>
      <p class="mt-3 text-neutral-600">
        {claimable ? (
          <>
            Nobody has claimed
            <span class="font-mono text-neutral-800">@{handle}</span> yet.
          </>
        ) : (
          'No short link or page lives at this address.'
        )}
      </p>
      <a
        class="group relative inline-block mt-6 text-sm font-medium text-neutral-600 focus:outline-hidden active:text-neutral-800"
        href="/"
      >
        <span
          class="absolute inset-0 translate-x-1.5 translate-y-1.5 bg-neutral-800 rounded-sm"
        ></span>
        <span
          class="relative flex items-center justify-center gap-3 rounded-sm border border-neutral-800 bg-white px-5 py-3 group-hover:translate-x-1 group-hover:translate-y-1 group-focus:translate-x-1 group-focus:translate-y-1"
        >
          Back to Mambruk
        </span>
      </a>
    </section>
  </main>
</Layout>
