---
import Layout from '../layouts/Layout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { isHandle } from '../utils/code.js'

export const prerender = false

// Routes rewrite here with status 200, so the page sets 404 itself.
Astro.response.status = 404
const handle = Astro.originPathname.match(/^\/@([^/]+)\/?$/)?.[1]?.toLowerCase()
const claimable = isHandle(handle)
---

<Layout title="Halaman tidak ditemukan">
  <SiteHeader />

  <main class="relative isolate flex-1 overflow-hidden">
    <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div
      class="mx-auto flex max-w-xl flex-col items-center px-4 py-24 text-center sm:py-32"
    >
      <span class="badge font-mono">404</span>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">
        Halaman tidak ditemukan
      </h1>
      <p class="mt-4 text-pretty text-neutral-600">
        {claimable ? (
          <>
            Handle <span class="font-mono text-neutral-900">@{handle}</span>
            belum dipakai siapa pun.
          </>
        ) : (
          'Tidak ada link atau halaman di alamat ini.'
        )}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href="/">Kembali ke beranda</a>
        {claimable && <a class="btn btn-secondary" href="/dashboard"
          >Klaim @{handle}</a
        >}
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
