---
import { env } from 'cloudflare:workers'
import Layout from '../../layouts/Layout.astro'
import { getUser, PROVIDERS } from '../../utils/auth'
import { ICON_NAMES } from '../../utils/icons.js'
import { THEMES, TOKENS, resolveTheme } from '../../utils/theme.js'

export const prerender = false

const user = await getUser(Astro)
const db = env.DB

type Page = {
  handle: string
  title: string
  tagline: string | null
  theme: string
  colors: string | null
}
type Link = { code: string; url: string; clicks: number }
type PageLink = {
  id: number
  section: string | null
  label: string
  description: string | null
  url: string
  icon: string | null
}

let page: Page | null = null
let aliases: Link[] = []
let pageLinks: PageLink[] = []

if (user && db) {
  page = await db
    .prepare(
      'SELECT handle, title, tagline, theme, colors FROM pages WHERE user_id = ?'
    )
    .bind(user.id)
    .first<Page>()

  if (page) {
    const rows = await db
      .prepare(
        'SELECT code, url, clicks FROM links WHERE handle = ? ORDER BY code'
      )
      .bind(page.handle)
      .all<Link>()
    aliases = rows.results ?? []

    const linkRows = await db
      .prepare(
        `SELECT id, section, label, description, url, icon
         FROM page_links WHERE handle = ? ORDER BY position`
      )
      .bind(page.handle)
      .all<PageLink>()
    pageLinks = linkRows.results ?? []
  }
}

const providers = Object.entries(PROVIDERS)

// What the colour inputs show, this page's preset plus its overrides.
const colors = resolveTheme(page?.theme ?? 'noir', page?.colors ?? null)
const TOKEN_LABELS: Record<string, string> = {
  bg: 'Page background',
  surface: 'Card background',
  fg: 'Primary text',
  muted: 'Secondary text',
  btn_bg: 'Button background',
  btn_fg: 'Button text',
  btn_border: 'Button border and shadow',
}
---

<Layout title="Dashboard - Mambruk">
  <main class="container mx-auto px-4 py-12 max-w-2xl">
    {!user ? (
      <div
        class="bg-white border border-neutral-800 rounded-xl p-6 sm:p-8 text-center"
      >
        <h1 class="text-2xl font-bold">Sign in to Mambruk</h1>
        <p class="mt-2 text-neutral-600">
          Sign in to claim a handle and make your own short links.
        </p>
        <div class="mt-6 flex flex-col gap-4">
          {providers.map(([key, provider]) => <a
            class="group relative inline-block text-sm font-medium text-neutral-600"
            href={`/api/auth/${key}`}
          >
            <span
              class="absolute inset-0 translate-x-1.5 translate-y-1.5 bg-neutral-800 rounded-sm"
            />
            <span
              class="relative flex items-center justify-center gap-3 rounded-sm border border-neutral-800 bg-white py-3 group-hover:translate-x-1 group-hover:translate-y-1"
            >
              Continue with {provider.label}
            </span>
          </a>)}
        </div>
      </div>
    ) : (
      <>
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            {user.avatar_url && (
              <img
                src={user.avatar_url}
                alt=""
                class="w-10 h-10 rounded-full"
              />
            )}
            <div>
              <p class="font-semibold">{user.name ?? user.email}</p>
              <p class="text-sm text-neutral-500">{user.email}</p>
            </div>
          </div>
          <form method="POST" action="/api/auth/logout">
            <button
              class="text-sm underline text-neutral-600 hover:text-neutral-900"
            >
              Sign out
            </button>
          </form>
        </div>

        <section
          class="mt-8 bg-white border border-neutral-800 rounded-xl p-6 sm:p-8"
        >
          <p
            class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-4"
          >
            Bio page
          </p>

          <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-8">
            <div>
              {page ? (
                <p>
                  <a class="font-mono underline" href={`/@${page.handle}`}>
                    /@{page.handle}
                  </a>
                  <span class="text-neutral-600"> - {page.title}</span>
                </p>
              ) : (
                <p class="text-neutral-600">You don't have a page yet.</p>
              )}

              <form
                id="pageForm"
                method="POST"
                action="/api/pages"
                class="mt-4 flex flex-col gap-3"
              >
                <input
                  name="handle"
                  value={page?.handle}
                  readonly={!!page}
                  required
                  placeholder="handle (lowercase, digits, -)"
                  class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden read-only:bg-neutral-100"
                />
                <input
                  name="title"
                  value={page?.title}
                  required
                  placeholder="Page title"
                  class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
                />
                <input
                  name="tagline"
                  value={page?.tagline ?? ''}
                  placeholder="Tagline (optional)"
                  class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
                />

                <fieldset>
                  <legend class="text-sm font-medium text-neutral-700 mb-2">
                    Theme
                  </legend>
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    {Object.entries(THEMES).map(([name, theme]) => <label
                      class="cursor-pointer"
                    >
                      <input
                        type="radio"
                        name="theme"
                        value={name}
                        checked={(page?.theme ?? 'noir') === name}
                        class="peer sr-only"
                      />
                      <div
                        class="rounded-lg border-2 border-neutral-200 p-2 transition-colors peer-checked:border-neutral-800 peer-focus-visible:ring-2 peer-focus-visible:ring-neutral-400"
                      >
                        <div
                          class="aspect-[3/4] rounded-sm flex flex-col items-center justify-center gap-1.5 px-2"
                          style={`background:${theme.bg}`}
                        >
                          <span
                            class="text-base font-bold leading-none"
                            style={`color:${theme.fg}`}
                          >
                            Aa
                          </span>
                          <span
                            class="w-full h-2.5 rounded-sm"
                            style={`background:${theme.btn_bg};border:1px solid ${theme.btn_border}`}
                          />
                          <span
                            class="w-full h-2.5 rounded-sm"
                            style={`background:${theme.btn_bg};border:1px solid ${theme.btn_border}`}
                          />
                        </div>
                        <p class="mt-1.5 text-xs text-center text-neutral-600">
                          {theme.label}
                        </p>
                      </div>
                    </label>)}
                  </div>
                </fieldset>

                <fieldset class="border-2 border-neutral-200 rounded-lg p-4">
                  <legend class="px-1 text-sm font-medium text-neutral-700">
                    Colours
                  </legend>
                  <p class="text-xs text-neutral-500 mb-3">
                    Leave these alone to follow the theme. Colours matching the
                    theme are not stored, so switching theme still works.
                  </p>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    {TOKENS.map((token) => <label
                      class="flex items-center justify-between gap-3 text-sm text-neutral-600"
                    >
                      {TOKEN_LABELS[token]}
                      <input
                        type="color"
                        name={token}
                        value={colors[token]}
                        class="h-9 w-14 rounded-sm border border-neutral-300 bg-white"
                      />
                    </label>)}
                  </div>
                </fieldset>

                <button
                  class="px-6 py-3 rounded-lg bg-neutral-800 text-white font-semibold hover:bg-neutral-700"
                >
                  {page ? 'Save' : 'Claim handle'}
                </button>
              </form>
            </div>

            {page && <div class="mt-8 lg:mt-0">
              <p
                class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3"
              >
                Preview
              </p>
              <div class="lg:sticky lg:top-6">
                <div
                  class="mx-auto w-[280px] rounded-[2rem] border-8 border-neutral-800 overflow-hidden bg-white"
                >
                  <iframe
                    id="preview"
                    src={`/@${page.handle}`}
                    title="Bio page preview"
                    class="w-full h-[520px] border-0"
                  />
                </div>
                <p class="mt-3 text-xs text-neutral-500 text-center">
                  Colours follow your picks. Content updates after saving.
                </p>
              </div>
            </div>}
          </div>
        </section>

        {page && <section
          class="mt-6 bg-white border border-neutral-800 rounded-xl p-6 sm:p-8"
        >
          <p
            class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-4"
          >
            Bio page content
          </p>

          {pageLinks.length === 0 ? (
            <p class="text-neutral-600">
              Your page is empty. Add the first button below.
            </p>
          ) : (
            <ul class="flex flex-col gap-3">
              {pageLinks.map((link, index) => <li
                class="flex items-start gap-3 border-b border-neutral-100 pb-3"
              >
                <div class="flex flex-col gap-1 pt-0.5">
                  <form method="POST" action="/api/page-links">
                    <input type="hidden" name="action" value="move" />
                    <input type="hidden" name="id" value={link.id} />
                    <input type="hidden" name="direction" value="up" />
                    <button
                      class="text-neutral-400 hover:text-neutral-800 disabled:opacity-30"
                      disabled={index === 0}
                      aria-label="Move up"
                    >
                      ↑
                    </button>
                  </form>
                  <form method="POST" action="/api/page-links">
                    <input type="hidden" name="action" value="move" />
                    <input type="hidden" name="id" value={link.id} />
                    <input type="hidden" name="direction" value="down" />
                    <button
                      class="text-neutral-400 hover:text-neutral-800 disabled:opacity-30"
                      disabled={index === pageLinks.length - 1}
                      aria-label="Move down"
                    >
                      ↓
                    </button>
                  </form>
                </div>

                <div class="flex-1 min-w-0">
                  <p class="font-medium">
                    {link.label}
                    {link.section && <span
                      class="ml-2 text-xs uppercase tracking-widest text-neutral-400"
                    >
                      {link.section}
                    </span>}
                  </p>
                  {link.description && <p class="text-sm text-neutral-500">
                    {link.description}
                  </p>}
                  <p class="text-sm text-neutral-400 truncate">
                    {link.url}
                  </p>
                </div>

                <form method="POST" action="/api/page-links">
                  <input type="hidden" name="action" value="delete" />
                  <input type="hidden" name="id" value={link.id} />
                  <button class="text-sm text-red-700 hover:underline">
                    Remove
                  </button>
                </form>
              </li>)}
            </ul>
          )}

          <form
            method="POST"
            action="/api/page-links"
            class="mt-5 flex flex-col gap-3"
          >
            <input type="hidden" name="action" value="add" />
            <input
              name="label"
              required
              placeholder="Button label, e.g. Follow us on Instagram"
              class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
            />
            <input
              type="url"
              name="url"
              required
              placeholder="https://destination.com/..."
              class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
            />
            <input
              name="description"
              placeholder="Short description (optional)"
              class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
            />
            <div class="flex flex-col sm:flex-row gap-3">
              <input
                name="section"
                list="sections"
                placeholder="Section, e.g. Social (optional)"
                class="flex-1 px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
              />
              <datalist id="sections">
                {[
                  ...new Set(pageLinks.map((l) => l.section).filter(Boolean)),
                ].map((s) => (
                  <option value={s} />
                ))}
              </datalist>
              <select
                name="icon"
                class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
              >
                <option value="">Icon: default</option>
                {ICON_NAMES.map((name) => <option value={name}>{name}</option>)}
              </select>
            </div>
            <button
              class="px-6 py-3 rounded-lg bg-neutral-800 text-white font-semibold hover:bg-neutral-700"
            >
              Add button
            </button>
          </form>
        </section>}

        {page && <section
          class="mt-6 bg-white border border-neutral-800 rounded-xl p-6 sm:p-8"
        >
          <p
            class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-4"
          >
            Short links
          </p>

          {aliases.length === 0 ? (
            <p class="text-neutral-600">No aliases yet.</p>
          ) : (
            <ul class="flex flex-col gap-2">
              {aliases.map((link) => <li
                class="flex items-baseline justify-between gap-3 border-b border-neutral-100 pb-2"
              >
                <a
                  class="font-mono text-sm underline"
                  href={`/@${page!.handle}/${link.code}`}
                >
                  /@{page!.handle}/{link.code}
                </a>
                <span class="text-sm text-neutral-500 truncate max-w-[45%]">
                  {link.url}
                </span>
                <span class="text-sm text-neutral-400 whitespace-nowrap">
                  {link.clicks} clicks
                </span>
              </li>)}
            </ul>
          )}

          <form
            method="POST"
            action="/api/links"
            class="mt-5 flex flex-col gap-3"
          >
            <input type="hidden" name="handle" value={page.handle} />
            <input
              name="alias"
              required
              placeholder="alias, e.g. ig"
              class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
            />
            <input
              type="url"
              name="url"
              required
              placeholder="https://destination.com/..."
              class="px-4 py-3 border-2 border-neutral-200 rounded-lg focus:border-neutral-800 focus:outline-hidden"
            />
            <button
              class="px-6 py-3 rounded-lg bg-neutral-800 text-white font-semibold hover:bg-neutral-700"
            >
              Save alias
            </button>
          </form>
        </section>}
      </>
    )}
  </main>
</Layout>

<script>
  import { THEMES, TOKENS } from '../../utils/theme.js'

  const form = document.getElementById('pageForm') as HTMLFormElement | null
  const frame = document.getElementById('preview') as HTMLIFrameElement | null

  if (form && frame) {
    // Same origin, so the variables can be set on the framed document directly.
    const paint = () => {
      const root = frame.contentDocument?.querySelector<HTMLElement>('main')
      if (!root) return
      for (const token of TOKENS) {
        const input = form.querySelector(`input[name="${token}"]`)
        if (input instanceof HTMLInputElement) {
          root.style.setProperty(`--mb-${token}`, input.value)
        }
      }
    }

    form.addEventListener('change', (event) => {
      const target = event.target
      // Picking a theme refills every colour input from that preset.
      if (target instanceof HTMLInputElement && target.name === 'theme') {
        const preset = THEMES[target.value]
        if (preset) {
          for (const token of TOKENS) {
            const input = form.querySelector(`input[name="${token}"]`)
            if (input instanceof HTMLInputElement) input.value = preset[token]
          }
        }
      }
      paint()
    })

    // Colour inputs fire input while dragging, change only at the end.
    form.addEventListener('input', paint)
    frame.addEventListener('load', paint)

    // Some browsers restore form values on back-navigation.
    paint()
  }
</script>
