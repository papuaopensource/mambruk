---
import { env } from 'cloudflare:workers'
import Layout from '../layouts/Layout.astro'
import Icon from '../components/Icon.astro'
import { resolveTheme, themeStyle } from '../utils/theme.js'

export const prerender = false

const { handle } = Astro.params
const db = env.DB

type Page = {
  handle: string
  title: string
  tagline: string | null
  avatar_url: string | null
  theme: string
  colors: string | null
}
type PageLink = {
  section: string | null
  label: string
  description: string | null
  url: string
  icon: string | null
}

let page: Page | null = null
let links: PageLink[] = []

if (db && handle) {
  page = await db
    .prepare(
      'SELECT handle, title, tagline, avatar_url, theme, colors FROM pages WHERE handle = ? AND published = 1'
    )
    .bind(handle.toLowerCase())
    .first<Page>()

  if (page) {
    const rows = await db
      .prepare(
        'SELECT section, label, description, url, icon FROM page_links WHERE handle = ? ORDER BY position'
      )
      .bind(page.handle)
      .all<PageLink>()
    links = rows.results ?? []
  }
}

if (!page) Astro.response.status = 404

// Group by section, keeping the order sections first appear in.
const sections: { name: string | null; links: PageLink[] }[] = []
for (const link of links) {
  const last = sections[sections.length - 1]
  if (last && last.name === link.section) last.links.push(link)
  else sections.push({ name: link.section, links: [link] })
}

const title = page ? page.title : 'Page not found'

// resolveTheme narrows these to #rrggbb.
const style = themeStyle(
  resolveTheme(page?.theme ?? 'noir', page?.colors ?? null)
)
---

<Layout
  title={title}
  description={page?.tagline ?? undefined}
  image={page?.avatar_url ?? undefined}
>
  <main
    class="flex items-center justify-center min-h-screen p-4 bg-[var(--mb-bg)] text-[var(--mb-fg)]"
    style={style}
  >
    <div
      class="w-full max-w-xl bg-[var(--mb-surface)] shadow-sm rounded-xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-16"
    >
      {page ? (
        <>
          <div class="mx-auto text-center">
            {page.avatar_url && (
              <img
                src={page.avatar_url}
                alt={`Logo ${page.title}`}
                class="w-40 h-40 mx-auto rounded-lg"
              />
            )}
            <h1 class="mt-6 text-lg font-semibold text-[var(--mb-fg)]">
              {page.title}
            </h1>
            {page.tagline && <p class="mt-2 text-[var(--mb-muted)]">
              {page.tagline}
            </p>}
          </div>

          <div class="mt-8 mx-auto flex flex-col gap-8">
            {sections.map((section) => <div>
              {section.name && <p
                class="text-xs font-semibold uppercase tracking-widest text-[var(--mb-muted)] mb-3"
              >
                {section.name}
              </p>}
              <div class="grid grid-cols-1 gap-4">
                {section.links.map((link) => <a
                  class="group relative inline-block text-sm font-medium text-[var(--mb-btn_fg)] focus:outline-hidden"
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span
                    class="absolute inset-0 translate-x-1.5 translate-y-1.5 bg-[var(--mb-btn_border)] rounded-sm"
                  />
                  <span
                    class="relative flex items-center justify-center gap-3 rounded-sm border border-[var(--mb-btn_border)] bg-[var(--mb-btn_bg)] px-4 py-4 group-hover:translate-x-1 group-hover:translate-y-1 group-focus:translate-x-1 group-focus:translate-y-1"
                  >
                    <Icon name={link.icon} />
                    <span class="flex flex-col items-center">
                      <span>{link.label}</span>
                      {link.description && <span
                        class="text-xs font-normal text-[var(--mb-muted)]"
                      >
                        {link.description}
                      </span>}
                    </span>
                  </span>
                </a>)}
              </div>
            </div>)}
          </div>
        </>
      ) : (
        <div class="text-center">
          <h1 class="text-lg font-semibold">Page not found</h1>
          <p class="mt-2 text-[var(--mb-muted)]">
            Nobody has claimed <span class="font-mono">@{handle}</span> yet.
          </p>
          <a class="mt-6 inline-block text-sm underline" href="/">
            Back to Mambruk
          </a>
        </div>
      )}

      <div class="mt-12 text-center text-sm text-[var(--mb-muted)]">
        <a class="hover:text-neutral-800" href="/">Built with Mambruk</a>
      </div>
    </div>
  </main>
</Layout>
