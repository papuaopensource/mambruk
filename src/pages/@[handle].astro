---
import Layout from '../layouts/Layout.astro'
import Icon from '../components/Icon.astro'

export const prerender = false

const { handle } = Astro.params
const db = Astro.locals.runtime?.env?.DB

type Page = {
  handle: string
  title: string
  tagline: string | null
  avatar_url: string | null
  theme: string
}
type PageLink = {
  section: string | null
  label: string
  description: string | null
  url: string
  icon: string | null
}

let page: Page | null = null
let links: PageLink[] = []

if (db && handle) {
  page = await db
    .prepare(
      'SELECT handle, title, tagline, avatar_url, theme FROM pages WHERE handle = ? AND published = 1'
    )
    .bind(handle.toLowerCase())
    .first<Page>()

  if (page) {
    const rows = await db
      .prepare(
        'SELECT section, label, description, url, icon FROM page_links WHERE handle = ? ORDER BY position'
      )
      .bind(page.handle)
      .all<PageLink>()
    links = rows.results ?? []
  }
}

if (!page) Astro.response.status = 404

// Group by section, keeping the order the sections first appear in.
const sections: { name: string | null; links: PageLink[] }[] = []
for (const link of links) {
  const last = sections[sections.length - 1]
  if (last && last.name === link.section) last.links.push(link)
  else sections.push({ name: link.section, links: [link] })
}

const title = page ? page.title : 'Halaman tidak ditemukan'
---

<Layout title={title} description={page?.tagline ?? undefined}>
  <main class="flex items-center justify-center min-h-screen p-4">
    <div
      class="w-full max-w-xl bg-white shadow rounded-xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-16"
    >
      {
        page ? (
          <>
            <div class="mx-auto text-center">
              {page.avatar_url && (
                <img
                  src={page.avatar_url}
                  alt={`Logo ${page.title}`}
                  class="w-40 h-40 mx-auto rounded-lg"
                />
              )}
              <h1 class="mt-6 text-lg font-semibold text-neutral-800">
                {page.title}
              </h1>
              {page.tagline && (
                <p class="mt-2 text-neutral-600">{page.tagline}</p>
              )}
            </div>

            <div class="mt-8 mx-auto flex flex-col gap-8">
              {sections.map((section) => (
                <div>
                  {section.name && (
                    <p class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3">
                      {section.name}
                    </p>
                  )}
                  <div class="grid grid-cols-1 gap-4">
                    {section.links.map((link) => (
                      <a
                        class="group relative inline-block text-sm font-medium text-neutral-600 focus:outline-none active:text-neutral-800"
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span class="absolute inset-0 translate-x-1.5 translate-y-1.5 bg-neutral-800 rounded" />
                        <span class="relative flex items-center justify-center gap-3 rounded border border-neutral-800 bg-white px-4 py-4 group-hover:translate-x-1 group-hover:translate-y-1 group-focus:translate-x-1 group-focus:translate-y-1">
                          <Icon name={link.icon} />
                          <span class="flex flex-col items-center">
                            <span>{link.label}</span>
                            {link.description && (
                              <span class="text-xs font-normal text-neutral-500">
                                {link.description}
                              </span>
                            )}
                          </span>
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : (
          <div class="text-center">
            <h1 class="text-lg font-semibold">Halaman tidak ditemukan</h1>
            <p class="mt-2 text-neutral-600">
              Handle <span class="font-mono">@{handle}</span> belum dipakai.
            </p>
            <a class="mt-6 inline-block text-sm underline" href="/">
              Kembali ke Mambruk
            </a>
          </div>
        )
      }

      <div class="mt-12 text-center text-sm text-neutral-500">
        <a class="hover:text-neutral-800" href="/">Dibuat dengan Mambruk</a>
      </div>
    </div>
  </main>
</Layout>
