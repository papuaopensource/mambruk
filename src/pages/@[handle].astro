---
import { env } from 'cloudflare:workers'
import Layout from '../layouts/Layout.astro'
import Icon from '../components/Icon.astro'
import UiIcon from '../components/UiIcon.astro'
import Logo from '../components/Logo.astro'
import { resolveTheme, themeStyle } from '../utils/theme.js'

export const prerender = false

const { handle } = Astro.params
const db = env.DB

type Page = {
  handle: string
  title: string
  tagline: string | null
  avatar_url: string | null
  theme: string
  colors: string | null
}
type PageLink = {
  section: string | null
  label: string
  description: string | null
  url: string
  icon: string | null
}

let page: Page | null = null
let links: PageLink[] = []

if (db && handle) {
  page = await db
    .prepare(
      'SELECT handle, title, tagline, avatar_url, theme, colors FROM pages WHERE handle = ? AND published = 1'
    )
    .bind(handle.toLowerCase())
    .first<Page>()

  if (page) {
    const rows = await db
      .prepare(
        'SELECT section, label, description, url, icon FROM page_links WHERE handle = ? ORDER BY position'
      )
      .bind(page.handle)
      .all<PageLink>()
    links = rows.results ?? []
  }
}

if (!page) return Astro.rewrite('/404')

// Group by section, keeping the order sections first appear in.
const sections: { name: string | null; links: PageLink[] }[] = []
for (const link of links) {
  const last = sections[sections.length - 1]
  if (last && last.name === link.section) last.links.push(link)
  else sections.push({ name: link.section, links: [link] })
}

// resolveTheme narrows these to #rrggbb.
const style = themeStyle(resolveTheme(page.theme, page.colors))
---

<Layout
  title={page.title}
  description={page.tagline ?? undefined}
  image={page.avatar_url ?? undefined}
>
  <main
    class="flex flex-1 justify-center bg-[var(--mb-bg)] px-4 py-10 text-[var(--mb-fg)] sm:py-16"
    style={style}
  >
    <div class="w-full max-w-md">
      <div
        class="rounded-3xl border border-[var(--mb-fg)]/10 bg-[var(--mb-surface)] px-5 py-10 shadow-sm sm:px-8"
      >
        <div class="text-center">
          {page.avatar_url && (
            <img
              src={page.avatar_url}
              alt={`Logo ${page.title}`}
              class="mx-auto size-24 rounded-full object-cover shadow-sm ring-4 ring-[var(--mb-bg)]"
            />
          )}
          <h1 class="mt-5 text-xl font-semibold tracking-tight">
            {page.title}
          </h1>
          {page.tagline && <p
            class="mx-auto mt-2 max-w-xs text-sm text-pretty text-[var(--mb-muted)]"
          >
            {page.tagline}
          </p>}
        </div>

        <div class="mt-9 flex flex-col gap-7">
          {sections.map((section) => <div>
            {section.name && <p
              class="mb-3 text-center text-[11px] font-medium tracking-[0.14em] text-[var(--mb-muted)] uppercase"
            >
              {section.name}
            </p>}
            <div class="flex flex-col gap-3">
              {section.links.map((link) => <a
                class="group flex items-center gap-3 rounded-2xl border border-[var(--mb-btn_border)] bg-[var(--mb-btn_bg)] px-4 py-3.5 text-[var(--mb-btn_fg)] transition duration-150 hover:-translate-y-0.5 hover:shadow-[0_4px_0_0_var(--mb-btn_border)] focus-visible:ring-4 focus-visible:ring-[var(--mb-btn_border)]/30 focus-visible:outline-hidden"
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={link.icon} />
                <span class="min-w-0 flex-1 text-center">
                  <span class="block text-sm font-medium">{link.label}</span>
                  {link.description && <span
                    class="mt-0.5 block text-xs text-[var(--mb-muted)]"
                  >
                    {link.description}
                  </span>}
                </span>
                <UiIcon
                  name="arrow-up-right"
                  class="size-4 shrink-0 opacity-40 transition group-hover:opacity-80"
                />
              </a>)}
            </div>
          </div>)}
        </div>
      </div>

      <a
        class="mx-auto mt-6 flex w-fit items-center gap-2 rounded-full px-3 py-1.5 text-xs font-medium text-[var(--mb-muted)] transition hover:text-[var(--mb-fg)]"
        href="/"
      >
        <Logo class="size-4" />
        Dibuat dengan Mambruk
      </a>
    </div>
  </main>
</Layout>
