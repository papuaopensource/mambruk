---
import { env } from 'cloudflare:workers'
import Layout from '../../layouts/Layout.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import UiIcon from '../../components/UiIcon.astro'
import PageSettings from '../../components/dashboard/PageSettings.astro'
import PageLinks from '../../components/dashboard/PageLinks.astro'
import ShortLinks from '../../components/dashboard/ShortLinks.astro'
import OwnLinks from '../../components/dashboard/OwnLinks.astro'
import { getUser } from '../../utils/auth'

export const prerender = false

const user = await getUser(Astro)
if (!user) return Astro.redirect('/login', 302)
const db = env.DB

type Page = {
  handle: string
  title: string
  tagline: string | null
  theme: string
  colors: string | null
}
type Link = { code: string; url: string; clicks: number }
type PageLink = {
  id: number
  section: string | null
  label: string
  description: string | null
  url: string
  icon: string | null
}

let page: Page | null = null
let aliases: Link[] = []
let pageLinks: PageLink[] = []
let ownLinks: Link[] = []

if (db) {
  const own = await db
    .prepare(
      "SELECT code, url, clicks FROM links WHERE user_id = ? AND handle = '' ORDER BY created_at DESC"
    )
    .bind(user.id)
    .all<Link>()
  ownLinks = own.results ?? []

  page = await db
    .prepare(
      'SELECT handle, title, tagline, theme, colors FROM pages WHERE user_id = ?'
    )
    .bind(user.id)
    .first<Page>()

  if (page) {
    const rows = await db
      .prepare(
        'SELECT code, url, clicks FROM links WHERE handle = ? ORDER BY code'
      )
      .bind(page.handle)
      .all<Link>()
    aliases = rows.results ?? []

    const linkRows = await db
      .prepare(
        `SELECT id, section, label, description, url, icon
         FROM page_links WHERE handle = ? ORDER BY position`
      )
      .bind(page.handle)
      .all<PageLink>()
    pageLinks = linkRows.results ?? []
  }
}

const initial = (user.name ?? user.email).charAt(0).toUpperCase()
---

<Layout title="Dashboard - Mambruk">
  <SiteHeader user={user}>
    <span class="hidden items-center gap-2 pr-1 text-sm sm:flex">
      {user.avatar_url ? (
        <img src={user.avatar_url} alt="" class="size-7 rounded-full" />
      ) : (
        <span
          class="flex size-7 items-center justify-center rounded-full bg-goura-100 text-xs font-semibold text-goura-700"
        >
          {initial}
        </span>
      )}
      <span class="max-w-40 truncate font-medium">
        {user.name ?? user.email}
      </span>
    </span>
    <form method="POST" action="/api/auth/logout">
      <button class="btn btn-ghost">Keluar</button>
    </form>
  </SiteHeader>

  <main class="flex-1 bg-neutral-50">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight">Dashboard</h1>
          <p class="mt-1 text-sm text-neutral-500">
            {page
              ? 'Atur halaman bio, tombol, dan link pendekmu.'
              : 'Pilih handle untuk mulai membuat halaman bio.'}
          </p>
        </div>
        {page && <a
          class="btn btn-secondary"
          href={`/@${page.handle}`}
          target="_blank"
          rel="noopener"
        >
          <span class="font-mono text-xs">/@{page.handle}</span>
          <UiIcon name="arrow-up-right" class="size-3.5" />
        </a>}
      </div>

      <div class="mt-8 flex flex-col gap-6">
        <PageSettings page={page} />
        {page && <PageLinks links={pageLinks} />}
        {page && <ShortLinks handle={page.handle} links={aliases} />}
        <OwnLinks links={ownLinks} />
      </div>
    </div>
  </main>

  <SiteFooter />
</Layout>
