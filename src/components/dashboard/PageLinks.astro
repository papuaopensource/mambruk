---
// The buttons on the bio page, with reorder, remove and add.
import Icon from '../Icon.astro'
import { ICON_NAMES } from '../../utils/icons.js'

export interface Props {
  links: {
    id: number
    section: string | null
    label: string
    description: string | null
    url: string
    icon: string | null
  }[]
}

const { links } = Astro.props
const sections = [...new Set(links.map((l) => l.section).filter(Boolean))]
const MOVES = [
  { direction: 'up', label: 'Naikkan', glyph: '↑' },
  { direction: 'down', label: 'Turunkan', glyph: '↓' },
] as const
---

<section class="card">
  <header class="border-b border-neutral-100 px-5 py-4">
    <h2 class="text-sm font-semibold">Tombol</h2>
    <p class="mt-0.5 text-sm text-neutral-500">
      Yang dilihat pengunjung di halamanmu, dari atas ke bawah.
    </p>
  </header>

  {links.length === 0 ? (
    <p class="px-5 py-10 text-center text-sm text-neutral-500">
      Halamanmu masih kosong. Tambahkan tombol pertama di bawah.
    </p>
  ) : (
    <ul class="divide-y divide-neutral-100">
      {links.map((link, index) => <li class="flex items-center gap-3 px-5 py-3">
        <div class="flex flex-col">
          {MOVES.map((move) => <form method="POST" action="/api/page-links">
            <input type="hidden" name="action" value="move" />
            <input type="hidden" name="id" value={link.id} />
            <input type="hidden" name="direction" value={move.direction} />
            <button
              class="flex size-6 items-center justify-center rounded-md text-xs text-neutral-400 hover:bg-neutral-100 hover:text-neutral-900 disabled:opacity-30 disabled:hover:bg-transparent"
              disabled={
                move.direction === 'up'
                  ? index === 0
                  : index === links.length - 1
              }
              aria-label={move.label}
            >
              {move.glyph}
            </button>
          </form>)}
        </div>

        <span
          class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-neutral-200 bg-neutral-50 text-neutral-600"
        >
          <Icon name={link.icon} class="size-4" />
        </span>

        <div class="min-w-0 flex-1">
          <p class="flex flex-wrap items-center gap-2 text-sm font-medium">
            {link.label}
            {link.section && <span
              class="rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-neutral-600"
            >
              {link.section}
            </span>}
          </p>
          {link.description && <p class="truncate text-sm text-neutral-500">
            {link.description}
          </p>}
          <p class="truncate text-xs text-neutral-400">{link.url}</p>
        </div>

        <form method="POST" action="/api/page-links">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={link.id} />
          <button
            class="rounded-md px-2 py-1 text-xs font-medium text-neutral-500 hover:bg-red-50 hover:text-red-600"
          >
            Hapus
          </button>
        </form>
      </li>)}
    </ul>
  )}

  <form
    method="POST"
    action="/api/page-links"
    class="border-t border-neutral-100"
  >
    <input type="hidden" name="action" value="add" />
    <div class="grid gap-4 p-5 sm:grid-cols-2">
      <label class="block">
        <span class="field-label">Label</span>
        <input
          name="label"
          required
          placeholder="Instagram kami"
          class="field"
        />
      </label>
      <label class="block">
        <span class="field-label">Link</span>
        <input
          type="url"
          name="url"
          required
          placeholder="https://tujuan.com/..."
          class="field"
        />
      </label>
      <label class="block sm:col-span-2">
        <span class="field-label">
          Deskripsi <span class="font-normal text-neutral-400">Opsional</span>
        </span>
        <input
          name="description"
          placeholder="Keterangan singkat di bawah label"
          class="field"
        />
      </label>
      <label class="block">
        <span class="field-label">
          Bagian <span class="font-normal text-neutral-400">Opsional</span>
        </span>
        <input
          name="section"
          list="sections"
          placeholder="Sosial"
          class="field"
        />
        <datalist id="sections">
          {sections.map((s) => (
            <option value={s} />
          ))}
        </datalist>
      </label>
      <label class="block">
        <span class="field-label">Ikon</span>
        <select name="icon" class="field">
          <option value="">Bawaan</option>
          {ICON_NAMES.map((name) => <option value={name}>{name}</option>)}
        </select>
      </label>
    </div>
    <footer
      class="flex items-center justify-between gap-3 rounded-b-xl border-t border-neutral-100 bg-neutral-50 px-5 py-3"
    >
      <p class="text-xs text-neutral-500">Label dan link wajib diisi.</p>
      <button class="btn btn-primary">Tambah tombol</button>
    </footer>
  </form>
</section>
