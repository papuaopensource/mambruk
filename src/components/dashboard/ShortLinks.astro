---
// Aliases under the handle, with their click counts, edit and delete.
import LinkRow from './LinkRow.astro'
import { HOST as host } from '../../utils/site'

export interface Props {
  handle: string
  links: { code: string; url: string; clicks: number }[]
}

const { handle, links } = Astro.props
const ACTION_BUTTON =
  'cursor-pointer rounded-md px-2 py-1 text-xs font-medium text-neutral-500'
---

<section class="card">
  <header class="border-b border-neutral-100 px-5 py-4">
    <h2 class="text-sm font-semibold">Alias</h2>
    <p class="mt-0.5 text-sm text-neutral-500">
      Alias di bawah handle-mu, misalnya
      <span class="font-mono text-xs text-neutral-700">/@{handle}/ig</span>.
    </p>
  </header>

  {links.length === 0 ? (
    <p class="px-5 py-10 text-center text-sm text-neutral-500">
      Belum ada alias.
    </p>
  ) : (
    <ul class="divide-y divide-neutral-100">
      {links.map((link) => <LinkRow
        href={`/@${handle}/${link.code}`}
        label={`${host}/@${handle}/${link.code}`}
        url={link.url}
        clicks={link.clicks}
      >
        <div class="flex w-full shrink-0 items-center justify-end sm:w-auto">
          <details class="relative">
            <summary
              class:list={[
                ACTION_BUTTON,
                'list-none hover:bg-neutral-100 hover:text-neutral-900 [&::-webkit-details-marker]:hidden',
              ]}
            >
              Ubah
            </summary>
            <form
              method="POST"
              action="/api/links"
              class="card absolute right-0 z-10 mt-2 w-72 max-w-[calc(100vw-2.5rem)] p-3 shadow-lg"
            >
              <input type="hidden" name="action" value="update" />
              <input type="hidden" name="alias" value={link.code} />
              <label class="block">
                <span class="field-label">Tujuan baru</span>
                <input
                  type="url"
                  name="url"
                  value={link.url}
                  required
                  class="field"
                />
              </label>
              <div class="mt-3 flex justify-end">
                <button class="btn btn-primary h-8">Simpan</button>
              </div>
            </form>
          </details>
          <form
            method="POST"
            action="/api/links"
            data-confirm="Hapus alias ini?"
            data-confirm-text={`/@${handle}/${link.code} akan berhenti bekerja di mana pun link-nya sudah dibagikan.`}
            data-confirm-label="Hapus"
            data-confirm-danger
          >
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="alias" value={link.code} />
            <button
              class:list={[ACTION_BUTTON, 'hover:bg-red-50 hover:text-red-600']}
            >
              Hapus
            </button>
          </form>
        </div>
      </LinkRow>)}
    </ul>
  )}

  <form method="POST" action="/api/links" class="border-t border-neutral-100">
    <input type="hidden" name="action" value="add" />
    <div class="grid gap-4 p-5 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
      <label class="block">
        <span class="field-label">Alias</span>
        <span class="flex">
          <span class="field-addon">/@{handle}/</span>
          <input
            name="alias"
            required
            placeholder="ig"
            class="field rounded-l-none"
          />
        </span>
      </label>
      <label class="block">
        <span class="field-label">Tujuan</span>
        <input
          type="url"
          name="url"
          required
          placeholder="https://tujuan.com/..."
          class="field"
        />
      </label>
    </div>
    <footer
      class="flex items-center justify-between gap-3 rounded-b-xl border-t border-neutral-100 bg-neutral-50 px-5 py-3"
    >
      <p class="text-xs text-neutral-500">
        Huruf kecil, angka, tanda hubung, dan garis bawah.
      </p>
      <button class="btn btn-primary">Simpan alias</button>
    </footer>
  </form>
</section>
