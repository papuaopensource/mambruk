---
// Root links the user made while signed in, custom codes included.
import LinkRow from './LinkRow.astro'
import { HOST as host } from '../../utils/site'

export interface Props {
  links: { code: string; url: string; clicks: number }[]
}

const { links } = Astro.props
---

<section class="card">
  <header
    class="flex items-start justify-between gap-4 border-b border-neutral-100 px-5 py-4"
  >
    <div>
      <h2 class="text-sm font-semibold">Link milikmu</h2>
      <p class="mt-0.5 text-sm text-neutral-500">
        Link pendek yang kamu buat di beranda saat sudah masuk, termasuk link
        custom.
      </p>
    </div>
    <a class="btn btn-secondary shrink-0" href="/">Buat link</a>
  </header>

  {links.length === 0 ? (
    <p class="px-5 py-10 text-center text-sm text-neutral-500">
      Belum ada link. Link yang kamu buat di beranda akan muncul di sini.
    </p>
  ) : (
    <ul class="divide-y divide-neutral-100">
      {links.map((link) => (
        <LinkRow
          href={`/${link.code}`}
          label={`${host}/${link.code}`}
          url={link.url}
          clicks={link.clicks}
        />
      ))}
    </ul>
  )}
</section>
