---
// `icon` is free text in page_links, so an unknown name gets the link glyph.
export interface Props {
  name?: string | null
  class?: string
}

import { ICONS } from '../utils/icons.js'

const { name, class: className = 'size-5' } = Astro.props
const icon = ICONS[name ?? ''] ?? ICONS.link
---

{icon.filled ? (
  <svg
    class:list={[className, 'shrink-0']}
    fill="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path d={icon.d} />
  </svg>
) : (
  <svg
    class:list={[className, 'shrink-0']}
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d={icon.d}
    />
  </svg>
)}
