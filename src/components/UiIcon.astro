---
// Interface glyphs for the app chrome. Bio page link icons live in icons.js.
const PATHS = {
  'arrow-down': 'M12 5v14m6-6-6 6-6-6',
  'arrow-right': 'M5 12h14m-6-6 6 6-6 6',
  'arrow-up': 'M12 19V5m-6 6 6-6 6 6',
  'arrow-up-right': 'M7 17 17 7M9 7h8v8',
  at: 'M16 12a4 4 0 1 0-8 0 4 4 0 0 0 8 0Zm0 0v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-9 9h4',
  chart: 'M4 20h16M7 16v-4m5 4V8m5 8v-6',
  check: 'm5 13 4 4L19 7',
  code: 'm8 9-4 3 4 3m8-6 4 3-4 3M14 5l-4 14',
  copy: 'M8 8h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2V8Zm8 0V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2',
  link: 'M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1',
  palette:
    'M12 3a9 9 0 0 0 0 18c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01a1.5 1.5 0 0 1 1.12-2.49H16a5 5 0 0 0 5-5c0-4.42-4.03-8-9-8ZM7.5 11.5h.01M10.5 7.5h.01M15 7.5h.01',
  plus: 'M12 5v14M5 12h14',
  shield: 'M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6l-7-3Zm-3 9 2 2 4-4',
}

export interface Props {
  name: keyof typeof PATHS
  class?: string
}

const { name, class: className = 'size-4' } = Astro.props
---

<svg
  class={className}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  <path d={PATHS[name]} />
</svg>
