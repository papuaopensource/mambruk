---
// Shell for the text pages: about, contact, help, privacy and terms.
import Layout from './Layout.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

export interface Props {
  title: string
  intro: string
  updated?: string
}

const { title, intro, updated } = Astro.props
const pageTitle = title.includes('Mambruk') ? title : `${title} - Mambruk`
---

<Layout title={pageTitle} description={intro}>
  <SiteHeader />

  <main class="flex-1">
    <div class="relative isolate overflow-hidden border-b border-neutral-200">
      <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
        <h1 class="text-4xl font-semibold tracking-tight">{title}</h1>
        <p class="mt-3 max-w-xl text-lg text-pretty text-neutral-600">
          {intro}
        </p>
        {updated && <p class="mt-4 text-sm text-neutral-500">
          Terakhir diperbarui {updated}
        </p>}
      </div>
    </div>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <slot />
    </div>
  </main>

  <SiteFooter />
</Layout>
